---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { findProductBySlug, allProducts } from '../../types/product';
import JournalDetails from '../../components/details/JournalDetails.astro';
import ApparelDetails from '../../components/details/ApparelDetails.astro';
import AccessoryDetails from '../../components/details/AccessoryDetails.astro';
import DigitalDetails from '../../components/details/DigitalDetails.astro';
import ReviewsFold from '../../components/ReviewsFold.astro';
import {
  productSchema,
  productBreadcrumbSchema,
  faqPageSchema,
} from '../../lib/schema';

const { category, slug } = Astro.params;
if (!category || !slug) return new Response('not found', { status: 404 });
const product = findProductBySlug(slug, category);
if (!product) return new Response('not found', { status: 404 });

const priceFormatted = new Intl.NumberFormat('en-GB', {
  style: 'currency', currency: 'GBP',
}).format(product.priceCents / 100);

const seoTitle = `${product.hook} · Oddly Wired`;
const seoDescription = (product.whyParagraph || product.hook).slice(0, 158);

const jsonLd = [
  productSchema(product),
  productBreadcrumbSchema(product),
  ...(product.faq && product.faq.length > 0 ? [faqPageSchema(product.faq)] : []),
];

// Same-category-first cross-sell with cross-category fill
const sameCategoryPool = allProducts.filter(
  (p) => p.category === product.category && p.slug !== product.slug
);
const otherCategoryPool = allProducts.filter(
  (p) => p.category !== product.category
);
const fromExplicit = (product.crossSellSlugs || [])
  .map((s) => allProducts.find((p) => p.slug === s && p.slug !== product.slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const crossSell: typeof allProducts = [...fromExplicit];
for (const p of [...sameCategoryPool, ...otherCategoryPool]) {
  if (crossSell.length >= 3) break;
  if (!crossSell.includes(p)) crossSell.push(p);
}
const crossSellFinal = crossSell.slice(0, 3);

const CROSS_SELL_COPY: Record<string, string> = {
  journal:   'Also on the wire',
  apparel:   'Also on the wire',
  accessory: 'Also on the wire',
  digital:   'Also on the wire',
  mug:       'Also on the wire',
};
const crossSellHeading = CROSS_SELL_COPY[product.productType] ?? 'Also on the wire';

const BACK_LINK_COPY: Record<string, { href: string; label: string }> = {
  journals:    { href: '/journals',    label: 'Journals' },
  apparel:     { href: '/apparel',     label: 'Apparel' },
  accessories: { href: '/accessories', label: 'Totes & more' },
  digital:     { href: '/digital',     label: 'Downloads' },
  mug:         { href: '/mugs',        label: 'Mugs' },
};
const backLink = BACK_LINK_COPY[product.category] ?? { href: '/', label: 'Shop' };
---
<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={product.heroImage}
  ogType="product"
  productMeta={{
    priceGBP: product.priceCents / 100,
    availability: 'in stock',
    retailerItemId: product.slug,
  }}
  jsonLd={jsonLd}
>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Oddly Wired</a><span aria-hidden="true">/</span><a href={backLink.href}>{backLink.label}</a>
  </nav>

  <section class="pf">
    <div class="pf-gallery">
      <img src={product.heroImage} alt={product.hook} class="pf-hero-image" loading="eager" fetchpriority="high"/>
      {product.gallery && product.gallery.length > 1 && (
        <div class="pf-thumbs">
          {product.gallery.slice(1, 4).map((src: string) => (
            <img src={src} alt="" class="pf-thumb" loading="lazy"/>
          ))}
        </div>
      )}
    </div>
    <div class="pf-info">
      <h1 class="pf-hook">{product.hook}</h1>
      <p class="pf-descriptor">{product.descriptor}</p>
      <p class="pf-price" id="displayed-price" data-base-cents={product.priceCents}>{priceFormatted}</p>
      <form id="checkout-form" data-price-id={product.stripePriceId} data-slug={product.slug}>
        {product.productType === 'apparel' && 'sizes' in product && Array.isArray((product as any).sizes) && (product as any).sizes.length > 1 && (
          <label class="pf-size-label" for="size-select">
            Size
            <select id="size-select" name="variant_id" class="pf-size-select" required>
              {(product as any).sizes.map((s: { name: string; sku: string; stockState: string; priceCents?: number }) => {
                const extraPence = (s.priceCents ?? product.priceCents) - product.priceCents;
                const upchargeLabel = extraPence > 0 ? ` (+£${(extraPence / 100).toFixed(0)})` : '';
                const stateLabel = s.stockState === 'low-stock' ? ' (low stock)' : s.stockState === 'sold-out' ? ' (sold out)' : '';
                return (
                  <option value={s.sku} data-price-cents={s.priceCents ?? product.priceCents} disabled={s.stockState === 'sold-out'} selected={s.name === 'M'}>
                    {s.name}{upchargeLabel}{stateLabel}
                  </option>
                );
              })}
            </select>
          </label>
        )}
        <div class="pf-buy-row">
          <button type="button" class="button" id="add-to-cart-btn" data-slug={product.slug}>Add to bag</button>
          <button type="submit" class="button outline" id="buy-btn">Buy it now</button>
        </div>
      </form>
      <ul class="pf-keypoints">
        {product.keypoints.map((kp: string) => <li>{kp}</li>)}
      </ul>
      <p class="pf-ships">Printed in the UK and posted in 3–5 working days. Secure checkout by Stripe.</p>
    </div>
  </section>

  {product.whyParagraph && (
    <section class="pf-why">
      <h2 class="pf-h2">Why it exists</h2>
      <p class="pf-why-body">{product.whyParagraph}</p>
    </section>
  )}

  {product.productType === 'journal'   && <JournalDetails product={product} />}
  {product.productType === 'apparel'   && <ApparelDetails product={product} />}
  {product.productType === 'accessory' && <AccessoryDetails product={product} />}
  {product.productType === 'digital'   && <DigitalDetails product={product} />}
  {product.productType === 'mug' && 'whatsInside' in product && (
    <section class="pf-block">
      <h2 class="pf-h2">What you get</h2>
      <ul class="pf-keypoints">
        {(product as any).whatsInside.map((item: string) => <li>{item}</li>)}
      </ul>
    </section>
  )}

  {product.faq && product.faq.length > 0 && (
    <section class="pf-block">
      <h2 class="pf-h2">Questions</h2>
      <div class="pf-faq">
        {product.faq.map((qa: { question: string; answer: string }) => (
          <details class="pf-faq-item">
            <summary>{qa.question}</summary>
            <p>{qa.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {crossSellFinal.length > 0 && (
    <section class="pf-more">
      <h2 class="pf-h2">{crossSellHeading}</h2>
      <div class="pf-cross-grid">
        {crossSellFinal.map((p) => (
          <ProductCard slug={p.slug} hook={p.hook} descriptor={p.descriptor}
            heroImage={p.heroImage} priceCents={p.priceCents} category={p.category} />
        ))}
      </div>
    </section>
  )}

  <ReviewsFold product={product} />

</BaseLayout>

<style>
  .crumbs {
    display: flex; flex-wrap: wrap; gap: var(--space-2xs);
    padding: var(--space-md) var(--gutter) 0 calc(var(--gutter) + var(--space-md));
    font-size: var(--text-sm); color: var(--muted);
  }
  .crumbs a { color: inherit; white-space: nowrap; text-decoration: none; }
  .crumbs a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--wire); }

  .pf {
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-2xl); align-items: start;
    padding: var(--space-lg) var(--gutter) var(--space-3xl) calc(var(--gutter) + var(--space-md));
  }
  .pf-hero-image { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--linen); display: block; }
  .pf-thumbs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-xs); margin-top: var(--space-xs); }
  .pf-thumb { width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--linen); display: block; }

  .pf-info { position: sticky; top: calc(56px + var(--space-lg)); }
  .pf-hook {
    margin: 0 0 var(--space-xs); min-width: 0; overflow-wrap: anywhere;
    font-family: var(--font-display); font-stretch: 75%; font-variation-settings: 'wdth' 75;
    font-weight: 800; line-height: 0.98; font-size: clamp(40px, 5vw, 72px);
  }
  .pf-descriptor { margin: 0 0 var(--space-lg); color: var(--muted); font-size: var(--text-sm); }
  .pf-price {
    margin: 0 0 var(--space-lg); font-size: var(--text-xl); font-weight: 600; font-variant-numeric: tabular-nums;
    padding-bottom: var(--space-sm); border-bottom: 1px solid var(--hairline);
  }
  .pf-size-label { display: block; margin-bottom: var(--space-md); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  .pf-size-select {
    display: block; margin-top: var(--space-2xs); min-width: 10rem; min-height: 44px;
    padding: 0 var(--space-sm); font: 500 var(--text-md) var(--font-body);
    background: var(--bone); color: var(--ink); border: 1px solid var(--ink); border-radius: 2px; cursor: pointer;
  }
  .pf-size-select:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .pf-buy-row { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-lg); }
  .pf-buy-row .button { flex: 1 1 10rem; text-align: center; white-space: nowrap; min-height: 48px; }
  #buy-btn:disabled, #add-to-cart-btn:disabled { opacity: 0.6; cursor: wait; }
  #add-to-cart-btn.added { background: var(--washed-black); }
  .pf-keypoints { list-style: none; padding: 0; margin: 0 0 var(--space-md); }
  .pf-keypoints li { position: relative; padding: var(--space-3xs) 0 var(--space-3xs) var(--space-md); line-height: 1.5; }
  .pf-keypoints li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 10px; height: 3px; border-radius: 2px; background: var(--wire); }
  .pf-ships { margin: 0; font-size: var(--text-sm); color: var(--muted); }

  .pf-h2 {
    margin: 0 0 var(--space-lg); min-width: 0; overflow-wrap: anywhere;
    font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
    font-weight: 800; text-transform: uppercase; line-height: 0.92; font-size: clamp(40px, 5vw, 72px);
  }
  .pf-why { background: var(--washed-black); color: var(--bone); padding: var(--space-2xl) var(--gutter) var(--space-2xl) calc(var(--gutter) + var(--space-md)); }
  .pf-why-body { margin: 0; font-size: clamp(20px, 2.2vw, 28px); line-height: 1.4; max-width: 40ch; }
  .pf-block { padding: var(--space-2xl) var(--gutter) 0 calc(var(--gutter) + var(--space-md)); }
  .pf-block > .pf-keypoints { max-width: 52ch; }

  .pf-faq { max-width: 52rem; border-top: 1px solid var(--hairline); }
  .pf-faq-item { border-bottom: 1px solid var(--hairline); }
  .pf-faq-item summary {
    cursor: pointer; list-style: none; padding: var(--space-md) var(--space-xl) var(--space-md) 0; position: relative;
    font-weight: 600; font-size: var(--text-lg); line-height: 1.35;
  }
  .pf-faq-item summary::-webkit-details-marker { display: none; }
  .pf-faq-item summary::after { content: '+'; position: absolute; right: 0; top: var(--space-md); font-weight: 400; }
  .pf-faq-item[open] summary::after { content: '–'; }
  .pf-faq-item summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .pf-faq-item p { margin: 0 0 var(--space-md); max-width: 60ch; line-height: 1.55; color: var(--muted); }

  .pf-more { padding: var(--space-3xl) var(--gutter) var(--space-3xl) calc(var(--gutter) + var(--space-md)); }
  .pf-cross-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); }

  @media (max-width: 860px) {
    .pf { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .pf-info { position: static; }
    .pf-cross-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  import { addToCart, refreshCartBadge } from '../../lib/cart';

  const form = document.getElementById('checkout-form') as HTMLFormElement | null;
  const buyBtn = document.getElementById('buy-btn') as HTMLButtonElement | null;
  const cartBtn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
  const sizeSel = document.getElementById('size-select') as HTMLSelectElement | null;
  const priceEl = document.getElementById('displayed-price') as HTMLElement | null;

  function selectedVariantId(): string | null {
    return sizeSel ? sizeSel.value : null;
  }

  // Live-update the displayed price when the size selection changes
  // (2XL upcharge etc). Reads data-price-cents off the selected <option>.
  if (sizeSel && priceEl) {
    const fmt = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' });
    sizeSel.addEventListener('change', () => {
      const opt = sizeSel.selectedOptions[0];
      const cents = Number(opt?.dataset?.priceCents);
      if (Number.isFinite(cents) && cents > 0) {
        priceEl.textContent = fmt.format(cents / 100);
      }
    });
  }

  if (form && buyBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const priceId = form.dataset.priceId;
      const slug = form.dataset.slug;
      const variantId = selectedVariantId();
      buyBtn.disabled = true;
      buyBtn.textContent = 'Taking you to checkout…';
      try {
        const body: Record<string, unknown> = { price_id: priceId, slug };
        if (variantId) body.variant_id = variantId;
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error('checkout failed');
        const { url } = await res.json();
        if (!url) throw new Error('no url returned');
        window.location.href = url;
      } catch (err) {
        buyBtn.disabled = false;
        buyBtn.textContent = 'That didn’t work. Try again';
        console.error(err);
      }
    });
  }

  if (cartBtn) {
    cartBtn.addEventListener('click', () => {
      const slug = cartBtn.dataset.slug!;
      const variantId = selectedVariantId() || undefined;
      addToCart({ slug, variantId, quantity: 1 });
      cartBtn.textContent = 'In your bag';
      cartBtn.classList.add('added');
      refreshCartBadge();
      setTimeout(() => {
        cartBtn.textContent = 'Add to bag';
        cartBtn.classList.remove('added');
      }, 1500);
    });
  }
</script>
