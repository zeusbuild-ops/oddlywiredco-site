---
// The club's story (brand-kit.md v3 §3, approved 2026-10-17). Signed Member 001:
// no founder name, no face. Paced as a read: opening line → the recognitions →
// the turn → the wire → the card.
import BaseLayout from '../layouts/BaseLayout.astro';
import WirePicker from '../components/WirePicker.astro';
import season from '../data/season.json';

const recognitions = [
  'Forty-seven tabs open, all important.',
  'The text you wrote in your head and never sent.',
  'A whole Saturday lost to finding out everything about lighthouses.',
  'Being told you were “a lot”, or “so much potential”,',
];
---
<BaseLayout
  title="The club · Oddly Wired"
  description="Oddly Wired is a club for adults with ADHD. Not a cure, not a superpower, not a checklist. Well-made things for people who get the joke, because they live it."
>
  <article class="story">
    <h1 class="opener">Nobody had to explain it to us.</h1>

    <ol class="recog">
      {recognitions.map((r) => <li>{r}</li>)}
    </ol>
    <p class="tail">and wondering for years why everything felt harder for you than for everyone else.</p>

    <section class="turn" aria-label="What the club is">
      <p class="turn-lead">Oddly Wired is a club for brains like ours.</p>
      <p class="isnt">
        It isn’t a <s>cure</s>, it isn’t a <s>superpower</s>, and it isn’t a <s>checklist</s>.
      </p>
      <p class="is">It’s well-made things for people who get the joke, because they live it.</p>
    </section>

    <section class="current" aria-label="Your wire">
      <p class="current-line">Every brain runs on its own current. So every piece comes in <span class="your">your wire</span>.</p>
      <WirePicker variant="full" />
    </section>

    <section class="sign" aria-label="Signed">
      <div class="card" aria-label="Membership card: Member 001">
        <svg class="card-mark" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="88" fill="none" stroke="currentColor" stroke-width="14"/>
          <path d="M35,100 Q55,65 75,100 Q95,135 115,100 Q135,65 155,100" stroke="var(--wire)" stroke-width="14" fill="none" stroke-linecap="round"/>
          <circle cx="35" cy="100" r="11" fill="var(--wire)"/><circle cx="155" cy="100" r="11" fill="var(--wire)"/>
        </svg>
        <p class="card-club">Oddly Wired</p>
        <p class="card-no">Member 001</p>
        <dl class="card-meta">
          <div><dt>Since</dt><dd>2026</dd></div>
          <div><dt>Wire</dt><dd data-current-wire>{season.wireName}</dd></div>
        </dl>
      </div>
      <div class="sign-copy">
        <p>Written by member 001, on behalf of everyone who read this far without opening another tab.</p>
        <div class="sign-actions">
          <a href="#newsletter" class="button">Join the club</a>
          <a href="/#lines" class="quiet">See the lines</a>
        </div>
      </div>
    </section>
  </article>

  <style>
    .story { padding: var(--space-3xl) var(--gutter) var(--space-3xl) calc(var(--gutter) + var(--space-md)); }
    .story > * { max-width: 1100px; }

    .opener {
      margin: 0 0 var(--space-3xl); min-width: 0; overflow-wrap: anywhere;
      font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
      font-weight: 800; text-transform: uppercase; line-height: 0.88;
      font-size: clamp(64px, 12vw, 184px);
    }

    .recog { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-lg); }
    .recog li {
      font-family: var(--font-display); font-stretch: 75%; font-variation-settings: 'wdth' 75;
      font-weight: 800; line-height: 1.02; font-size: clamp(30px, 4.6vw, 64px);
      max-width: 22ch;
    }
    .recog li:nth-child(even) { margin-left: clamp(0px, 12vw, 200px); }
    .tail { margin: var(--space-lg) 0 var(--space-3xl); font-size: var(--text-xl); line-height: 1.4; max-width: 32ch; color: var(--muted); }

    .turn { border-top: 1px solid var(--hairline); padding-top: var(--space-2xl); margin-bottom: var(--space-3xl); }
    .turn-lead {
      margin: 0 0 var(--space-lg);
      font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
      font-weight: 800; text-transform: uppercase; line-height: 0.92; font-size: clamp(44px, 7vw, 104px);
    }
    .isnt, .is { margin: 0 0 var(--space-md); font-size: clamp(22px, 2.6vw, 34px); line-height: 1.35; max-width: 34ch; }
    .isnt s { text-decoration-color: var(--wire); text-decoration-thickness: 0.14em; }
    .is { font-weight: 600; }

    .current { background: var(--linen); margin-left: calc(-1 * var(--space-md)); padding: var(--space-2xl) var(--space-xl); margin-bottom: var(--space-3xl); }
    .current-line { margin: 0 0 var(--space-xl); font-size: clamp(24px, 3vw, 40px); line-height: 1.25; max-width: 28ch; font-weight: 600; }
    .your { text-decoration: underline; text-decoration-color: var(--wire); text-decoration-thickness: 0.12em; text-underline-offset: 0.14em; }

    .sign { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-2xl); align-items: center; }
    .card {
      width: min(340px, 100%); aspect-ratio: 85.6 / 54; /* a real card's proportions */
      background: var(--ink); color: var(--bone); border-radius: 14px;
      padding: var(--space-md); display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto 1fr auto;
      column-gap: var(--space-xs);
      transform: rotate(-3deg);
      box-shadow: 0 18px 40px rgba(21, 21, 21, 0.22);
    }
    .card-mark { width: 30px; height: 30px; }
    .card-club {
      margin: 0; align-self: center;
      font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
      font-weight: 800; text-transform: uppercase; font-size: var(--text-lg); line-height: 1;
    }
    .card-no {
      grid-column: 1 / -1; align-self: end; margin: 0;
      font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
      font-weight: 800; text-transform: uppercase; font-size: clamp(32px, 4vw, 44px); line-height: 1;
    }
    .card-meta { grid-column: 1 / -1; display: flex; gap: var(--space-lg); margin: var(--space-xs) 0 0; }
    .card-meta div { display: flex; gap: var(--space-2xs); font-size: var(--text-xs); }
    .card-meta dt { color: var(--stone); text-transform: uppercase; letter-spacing: 0.12em; }
    .card-meta dd { margin: 0; font-weight: 600; }

    .sign-copy p { margin: 0 0 var(--space-lg); font-size: var(--text-lg); line-height: 1.5; max-width: 36ch; }
    .sign-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-lg); }
    .quiet { color: var(--ink); font-size: var(--text-sm); font-weight: 600; white-space: nowrap; text-decoration-color: var(--wire); text-decoration-thickness: 2px; text-underline-offset: 5px; }

    @media (max-width: 760px) {
      .recog li:nth-child(even) { margin-left: 0; }
      .current { margin-left: 0; padding: var(--space-xl) var(--space-md); }
      .sign { grid-template-columns: minmax(0, 1fr); }
      .card { transform: rotate(-2deg); }
    }
  </style>
</BaseLayout>
