---
// Hallmark · macrostructure: Wire Index (custom) — seasonal opener → pick your
// wire → the lines as a typographic index → statement footer. No card grids.
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonHero from '../components/SeasonHero.astro';
import WirePicker from '../components/WirePicker.astro';
import { allProducts, featuredProducts } from '../types/product';
import { organizationSchema, websiteSchema } from '../lib/schema';
import season from '../data/season.json';

const gbp = (c: number) => new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }).format(c / 100);
const kind: Record<string, string> = { journals: 'Journal', apparel: 'Apparel', mug: 'Mug', accessories: 'Tote & more', digital: 'Download' };

// Featured first, then a couple from each category, so every kind of thing shows up.
const picked = new Set(featuredProducts.map((p) => p.slug));
const extras = ['journals', 'apparel', 'mug', 'accessories'].flatMap((c) =>
  allProducts.filter((p) => p.category === c && !picked.has(p.slug)).slice(0, 2));
const lines = [...featuredProducts, ...extras].slice(0, 14);

const cats = [
  { label: 'journals', href: '/journals', n: allProducts.filter((p) => p.category === 'journals').length },
  { label: 'apparel', href: '/apparel', n: allProducts.filter((p) => p.category === 'apparel').length },
  { label: 'mugs', href: '/mugs', n: allProducts.filter((p) => p.category === 'mug').length },
  { label: 'totes & more', href: '/accessories', n: allProducts.filter((p) => p.category === 'accessories').length },
].filter((c) => c.n > 0);
---
<BaseLayout
  title="Oddly Wired — if you get it, you’re in"
  description="A club for adults with ADHD. Journals, apparel and mugs for people who get the joke, because they live it. Printed in the UK."
  jsonLd={[organizationSchema(), websiteSchema()]}
>
  <SeasonHero />

  <section class="pick">
    <h2 class="pick-title">Pick your wire.</h2>
    <div class="pick-body">
      <p>Every brain runs on its own current. Choose yours and the whole shop follows. We’ll remember it next time.</p>
      <WirePicker variant="full" />
      <p class="pick-note">This season’s wire is {season.wireName}. You’re on <strong data-current-wire>{season.wireName}</strong>.</p>
    </div>
  </section>

  <section class="lines" id="lines" aria-labelledby="lines-title">
    <h2 class="lines-title" id="lines-title">The lines</h2>
    <ol class="index">
      {lines.map((p) => (
        <li>
          <a href={`/${p.category}/${p.slug}`} class="row">
            <img class="thumb" src={p.heroImage} alt="" loading="lazy" width="72" height="72" />
            <span class="hook">{p.hook}</span>
            <span class="meta"><span class="kind">{kind[p.category] ?? p.category}</span><span class="price">{gbp(p.priceCents)}</span></span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more">
      Or go through all of it:{' '}
      {cats.map((c, i) => (
        <><a href={c.href}>{c.n} {c.label}</a>{i < cats.length - 1 ? ', ' : '.'}</>
      ))}
    </p>
  </section>

  <style>
    .pick {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-xl); align-items: start;
      padding: var(--space-3xl) var(--gutter) var(--space-2xl) calc(var(--gutter) + var(--space-md));
    }
    .pick-title, .lines-title {
      margin: 0; min-width: 0; overflow-wrap: anywhere;
      font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
      font-weight: 800; text-transform: uppercase; line-height: 0.9;
    }
    .pick-title { font-size: clamp(56px, 8vw, 120px); }
    .pick-body > p:first-child { margin: 0 0 var(--space-lg); font-size: var(--text-lg); line-height: 1.45; max-width: 34ch; }
    .pick-note { margin: var(--space-lg) 0 0; color: var(--muted); font-size: var(--text-sm); }
    .pick-note strong { color: var(--ink); }

    .lines {
      background: var(--linen);
      padding: var(--space-2xl) var(--gutter) var(--space-3xl) calc(var(--gutter) + var(--space-md));
    }
    .lines-title { font-size: clamp(40px, 5vw, 72px); margin-bottom: var(--space-lg); }
    .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
    .row {
      display: grid; grid-template-columns: 72px minmax(0, 1fr) auto;
      align-items: center; gap: var(--space-md);
      padding: var(--space-sm) 0; border-bottom: 1px solid var(--hairline);
      color: var(--ink); text-decoration: none;
    }
    .thumb { width: 72px; height: 72px; object-fit: cover; background: var(--bone); }
    .hook {
      min-width: 0; overflow-wrap: anywhere;
      font-family: var(--font-display); font-stretch: 75%; font-variation-settings: 'wdth' 75;
      font-weight: 800; line-height: 1.02; font-size: clamp(24px, 3.2vw, 44px);
      text-decoration: underline; text-decoration-color: transparent;
      text-decoration-thickness: 4px; text-underline-offset: 6px;
      transition: text-decoration-color var(--dur-short) var(--ease-out);
    }
    .row:hover .hook, .row:focus-visible .hook { text-decoration-color: var(--wire); }
    .row:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
    .meta { display: grid; justify-items: end; gap: var(--space-3xs); text-align: right; }
    .kind { font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
    .price { font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .more { margin: var(--space-xl) 0 0; font-size: var(--text-lg); line-height: 1.6; max-width: 60ch; }
    .more a { color: var(--ink); font-weight: 600; white-space: nowrap; text-decoration-color: var(--wire); text-decoration-thickness: 2px; text-underline-offset: 4px; }

    @media (max-width: 760px) {
      .pick { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); padding-top: var(--space-2xl); }
      .row { grid-template-columns: 56px minmax(0, 1fr); gap: var(--space-xs) var(--space-sm); }
      .thumb { width: 56px; height: 56px; grid-row: span 2; }
      .meta { grid-column: 2; display: flex; justify-content: flex-start; gap: var(--space-sm); text-align: left; }
    }
    @media (prefers-reduced-motion: reduce) { .hook { transition: none; } }
  </style>
</BaseLayout>
