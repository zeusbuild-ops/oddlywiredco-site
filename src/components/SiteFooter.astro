---
// Statement footer: the club line, the signup, one line of links.
// The wire running down the page ends here in a terminal dot.
import NewsletterForm from './NewsletterForm.astro';
const links = [
  { label: 'Etsy',      href: 'https://www.etsy.com/shop/OddlyWiredCo', ext: true },
  { label: 'Instagram', href: 'https://www.instagram.com/oddlywiredco/', ext: true },
  { label: 'TikTok',    href: 'https://www.tiktok.com/@oddlywiredco', ext: true },
  { label: 'Pinterest', href: 'https://uk.pinterest.com/oddlywiredco/', ext: true },
  { label: 'Shipping',  href: '/legal/shipping' },
  { label: 'Returns',   href: '/legal/returns' },
  { label: 'Privacy',   href: '/legal/privacy' },
  { label: 'Terms',     href: '/legal/terms' },
];
---
<footer class="site-footer" id="newsletter">
  <div class="statement">
    <p class="line">If you get it,<br><span>you’re in.</span></p>
    <div class="join">
      <p class="join-title">Join the club</p>
      <p class="join-sub">New wires and drops, before anyone else. No spam. No schedule. Very on brand.</p>
      <NewsletterForm />
    </div>
  </div>
  <div class="base">
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href} {...(l.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a></li>
      ))}
    </ul>
    <p class="copy">© 2026 Oddly Wired · Member 001</p>
  </div>
  <span class="terminal" aria-hidden="true"></span>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--ink); color: var(--bone);
    padding: var(--space-3xl) var(--gutter) var(--space-lg) calc(var(--gutter) + var(--space-md));
  }
  .statement {
    display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-2xl); align-items: end;
    max-width: 1240px; margin: 0 auto var(--space-3xl);
  }
  .line {
    margin: 0; min-width: 0; overflow-wrap: anywhere;
    font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
    font-weight: 800; text-transform: uppercase; line-height: 0.9;
    font-size: clamp(56px, 10vw, 150px);
  }
  .line span { text-decoration: underline; text-decoration-color: var(--wire); text-decoration-thickness: 0.07em; text-underline-offset: 0.12em; }
  .join-title {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
    font-weight: 800; text-transform: uppercase; font-size: var(--text-2xl); line-height: 1;
  }
  .join-sub { margin: 0 0 var(--space-md); color: var(--stone); max-width: 38ch; line-height: 1.5; }
  .join :global(.button) { background: var(--bone); color: var(--ink); }

  .base {
    max-width: 1240px; margin: 0 auto;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-md);
    border-top: 1px solid rgba(242, 240, 235, 0.16); padding-top: var(--space-md);
  }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); }
  .links a { color: var(--stone); font-size: var(--text-sm); text-decoration: none; white-space: nowrap; }
  .links a:hover { color: var(--bone); text-decoration: underline; text-decoration-color: var(--wire); text-underline-offset: 4px; }
  .links a:focus-visible { outline: 2px solid var(--bone); outline-offset: 3px; }
  .copy { margin: 0; color: var(--stone); font-size: var(--text-sm); }

  /* End of the wire. */
  .terminal {
    position: absolute; bottom: var(--space-lg);
    left: calc(var(--rail-x) + var(--rail-w) / 2); transform: translateX(-50%);
    width: calc(var(--rail-w) * 1.8); height: calc(var(--rail-w) * 1.8);
    border-radius: 50%; background: var(--wire); z-index: 2;
  }
  @media (max-width: 760px) {
    .statement { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
  }
</style>
