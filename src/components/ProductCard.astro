---
interface Props {
  slug: string;
  hook: string;
  descriptor: string;
  heroImage: string;
  priceCents: number;
  category?: string;
}
const { slug, hook, descriptor, heroImage, priceCents, category = 'journals' } = Astro.props;
const href = `/${category}/${slug}`;
const priceFormatted = new Intl.NumberFormat('en-GB', {
  style: 'currency', currency: 'GBP',
}).format(priceCents / 100);
---
<a href={href} class="card" aria-label={`${hook} — ${priceFormatted}`}>
  <div class="card-image"><img src={heroImage} alt="" loading="lazy"/></div>
  <h3 class="card-hook">{hook}</h3>
  <p class="card-descriptor">{descriptor}</p>
  <div class="card-meta">
    <span class="card-price">{priceFormatted}</span>
    <span class="card-arrow">View</span>
  </div>
</a>

<style>
  /* Papier-style card: the product photo does the work, text stays quiet. */
  .card {
    display: flex;
    flex-direction: column;
    color: var(--ink);
    text-decoration: none;
    height: 100%;
  }
  .card-image {
    aspect-ratio: 4 / 5;
    background: var(--linen);
    margin-bottom: 14px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .card:hover .card-image img { transform: scale(1.03); }
  .card-hook {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 4px;
  }
  .card-descriptor {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 10px;
  }
  .card-meta {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }
  .card-price { font-weight: 600; }
  .card-arrow { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .card:hover .card-arrow { color: var(--wire); }
  :global(.fold.dark) .card { color: var(--bone); }
  :global(.fold.dark) .card-descriptor, :global(.fold.dark) .card-arrow { color: var(--stone); }
  @media (prefers-reduced-motion: reduce) {
    .card-image img { transition: none; }
    .card:hover .card-image img { transform: none; }
  }
</style>
