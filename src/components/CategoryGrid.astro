---
// Category page body: big category name, a line in the club voice, a real
// count, then the products with the first one featured large.
// `heading` / `eyebrow` are kept for the existing pages' props but the title
// now comes from the category itself.
import ProductCard from './ProductCard.astro';
import type { Product } from '../types/product';
interface Props {
  products: Product[];
  heading: string;
  eyebrow?: string;
}
const { products, heading } = Astro.props;
const category = products[0]?.category ?? '';
const copy: Record<string, { title: string; noun: [string, string]; line: string }> = {
  journals:    { title: 'Journals',     noun: ['journal', 'journals'], line: 'Somewhere to put it all down. Before you forget you had it.' },
  apparel:     { title: 'Apparel',      noun: ['piece', 'pieces'],     line: 'Heavyweight. Worn by people who get it. Puzzles everyone else.' },
  mug:         { title: 'Mugs',         noun: ['mug', 'mugs'],         line: 'Something to hold while the brain reloads.' },
  accessories: { title: 'Totes & more', noun: ['thing', 'things'],     line: 'For carrying the doom pile in style.' },
  digital:     { title: 'Downloads',    noun: ['download', 'downloads'], line: 'Instant. No postage, no waiting. You’re welcome.' },
};
const c = copy[category] ?? { title: heading.replace(/\.$/, ''), noun: ['item', 'items'], line: '' };
const n = products.length;
const [lead, ...rest] = products;
---
<section class="cat">
  <header class="cat-head">
    <h1 class="title">{c.title}</h1>
    <div class="intro">
      {c.line && <p class="line">{c.line}</p>}
      <p class="count">{n} {n === 1 ? c.noun[0] : c.noun[1]}</p>
    </div>
  </header>

  <div class="grid">
    {lead && (
      <div class="lead">
        <ProductCard slug={lead.slug} hook={lead.hook} descriptor={lead.descriptor}
          heroImage={lead.heroImage} priceCents={lead.priceCents} category={lead.category} />
      </div>
    )}
    {rest.map((p) => (
      <ProductCard slug={p.slug} hook={p.hook} descriptor={p.descriptor}
        heroImage={p.heroImage} priceCents={p.priceCents} category={p.category} />
    ))}
  </div>
</section>

<style>
  .cat { padding: var(--space-2xl) var(--gutter) var(--space-3xl) calc(var(--gutter) + var(--space-md)); }
  .cat-head {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    gap: var(--space-lg); align-items: end;
    border-bottom: 1px solid var(--hairline); padding-bottom: var(--space-lg); margin-bottom: var(--space-xl);
  }
  .title {
    margin: 0; min-width: 0; overflow-wrap: anywhere;
    font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
    font-weight: 800; text-transform: uppercase; line-height: 0.86;
    font-size: clamp(72px, 14vw, 208px);
  }
  .line { margin: 0 0 var(--space-sm); font-size: var(--text-lg); line-height: 1.4; }
  .count {
    margin: 0; font-size: var(--text-sm); font-weight: 600; font-variant-numeric: tabular-nums;
    text-decoration: underline; text-decoration-color: var(--wire); text-decoration-thickness: 3px; text-underline-offset: 5px;
  }
  .grid {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-md);
  }
  .lead { grid-column: span 2; grid-row: span 2; }
  .lead :global(.card-hook) {
    font-family: var(--font-display); font-stretch: 75%; font-variation-settings: 'wdth' 75;
    font-weight: 800; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.05;
  }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .cat-head { grid-template-columns: minmax(0, 1fr); }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg) var(--space-sm); }
  }
  @media (max-width: 420px) {
    .lead { grid-row: auto; }
  }
</style>
