---
import type { ApparelProduct } from '../../types/product';
interface Props { product: ApparelProduct }
const { product } = Astro.props;
const end = (s: string) => (s ?? '').trim().replace(/\.+$/, '') + '.';
---
<section class="details-fold light">
  <div class="container">
    <h2 class="d-title">The details</h2>
    <p class="d-lead">{end(product.material)} {end(product.fitNote)}</p>
    <table class="size-table">
      <thead><tr><th>size</th><th>state</th></tr></thead>
      <tbody>
        {product.sizes.map((s) => (
          <tr class={`stock-${s.stockState}`}>
            <td>{s.name}</td>
            <td>{s.stockState.replace('-', ' ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .details-fold { padding: var(--space-2xl) var(--gutter) 0 calc(var(--gutter) + var(--space-md)); background: transparent; color: var(--ink); }
  .container { max-width: none; margin: 0; }
  .d-title {
    margin: 0 0 var(--space-md); min-width: 0; overflow-wrap: anywhere;
    font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
    font-weight: 800; text-transform: uppercase; line-height: 0.92; font-size: clamp(40px, 5vw, 72px);
  }
  .d-lead { margin: 0 0 var(--space-lg); font-size: var(--text-xl); line-height: 1.35; max-width: 40ch; font-weight: 600; }
  ul { list-style: none; margin: 0 0 var(--space-md); padding: 0; max-width: 52ch; }
  li { position: relative; padding: var(--space-3xs) 0 var(--space-3xs) var(--space-md); line-height: 1.5; }
  li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 10px; height: 3px; border-radius: 2px; background: var(--wire); }
  .trim { margin: 0; color: var(--muted); font-size: var(--text-sm); }
  .size-table { border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .size-table th, .size-table td { padding: var(--space-2xs) var(--space-lg) var(--space-2xs) 0; text-align: left; border-bottom: 1px solid var(--hairline); }
  .size-table th { font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .size-table tr.stock-sold-out td { color: var(--muted); text-decoration: line-through; }
</style>
