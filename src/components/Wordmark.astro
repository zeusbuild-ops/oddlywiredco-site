---
// v3 logo: the original circle + wire + end dots (thicker), with ODDLY WIRED
// in condensed capitals. Only the wire and dots take the wire colour; the
// circle follows the text colour (Ink on light, Bone on dark).
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'dark' | 'light' | 'darkmode';
  markOnly?: boolean;
}
const { size = 'md', variant = 'dark', markOnly = false } = Astro.props;
const color = variant === 'dark' ? 'var(--ink)' : 'var(--bone)';
const sizeMap = { sm: '22px', md: '34px', lg: '56px', xl: 'clamp(48px, 11vw, 120px)' };
---
<a href="/" class="wordmark" aria-label="Oddly Wired home" style={`font-size: ${sizeMap[size]}; color: ${color};`}>
  <svg class="mark" viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="88" fill="none" stroke="currentColor" stroke-width="14"/>
    <path d="M35,100 Q55,65 75,100 Q95,135 115,100 Q135,65 155,100" stroke="var(--wire)" stroke-width="14" fill="none" stroke-linecap="round"/>
    <circle cx="35" cy="100" r="11" fill="var(--wire)"/>
    <circle cx="155" cy="100" r="11" fill="var(--wire)"/>
  </svg>
  {!markOnly && <span class="word">Oddly Wired</span>}
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    line-height: 1;
  }
  .mark { width: 1.25em; height: 1.25em; flex-shrink: 0; }
  .word {
    font-family: var(--font-display);
    font-stretch: 62%;
    font-variation-settings: 'wdth' 62;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
</style>
