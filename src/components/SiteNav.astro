---
// Masthead nav: menu left, the mark centred, your wire + bag right.
// Category links live in the menu drawer at every width, so the bar stays quiet.
import Wordmark from './Wordmark.astro';
import WirePicker from './WirePicker.astro';
import { allProducts } from '../types/product';
const pathname = Astro.url.pathname;
const count = (c: string) => allProducts.filter((p) => p.category === c).length;
const links = [
  { label: 'Journals',     href: '/journals',    n: count('journals') },
  { label: 'Apparel',      href: '/apparel',     n: count('apparel') },
  { label: 'Mugs',         href: '/mugs',        n: count('mug') },
  { label: 'Totes & more', href: '/accessories', n: count('accessories') },
  { label: 'The club',     href: '/about',       n: 0 },
];
const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/oddlywiredco/' },
  { label: 'TikTok',    href: 'https://www.tiktok.com/@oddlywiredco' },
  { label: 'Pinterest', href: 'https://uk.pinterest.com/oddlywiredco/' },
];
const isActive = (href: string) => pathname.startsWith(href);
---
<header class="masthead" data-state="full">
  <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
    <span class="bars" aria-hidden="true"><span></span><span></span></span>
    <span class="menu-word">Menu</span>
  </button>
  <div class="brand"><Wordmark size="sm" variant="dark" /></div>
  <div class="right">
    <div class="wires-desktop"><WirePicker variant="compact" /></div>
    <a href="/cart" class="bag" aria-label="Bag">
      Bag <span class="bag-badge" data-cart-badge aria-hidden="true" style="display:none"></span>
    </a>
  </div>
</header>

<nav id="site-menu" class="menu" aria-label="Primary" hidden>
  <ul class="menu-links">
    {links.map((l) => (
      <li>
        <a href={l.href} class:list={[{ active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>
          <span>{l.label}</span>{l.n > 0 && <span class="n">{l.n}</span>}
        </a>
      </li>
    ))}
  </ul>
  <div class="menu-foot">
    <p class="menu-label">Your wire: <span data-current-wire></span></p>
    <WirePicker variant="compact" />
    <ul class="menu-socials">
      {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
    </ul>
  </div>
</nav>
<div id="nav-sentinel" aria-hidden="true"></div>

<script>
  import { refreshCartBadge } from '../lib/cart';
  refreshCartBadge();
  window.addEventListener('storage', (e) => { if (e.key === 'owc-cart') refreshCartBadge(); });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshCartBadge(); });

  const bar = document.querySelector<HTMLElement>('.masthead');
  const sentinel = document.getElementById('nav-sentinel');
  if (bar && sentinel) {
    new IntersectionObserver(([e]) => bar.setAttribute('data-state', e.isIntersecting ? 'full' : 'compact'))
      .observe(sentinel);
  }
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('site-menu');
  const close = () => { menu?.setAttribute('hidden', ''); btn?.setAttribute('aria-expanded', 'false'); btn?.setAttribute('aria-label', 'Open menu'); };
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    if (open) { close(); return; }
    if (menu && bar) menu.style.top = `${bar.getBoundingClientRect().bottom}px`;
    menu?.removeAttribute('hidden');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Close menu');
  });
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>

<style>
  .masthead {
    position: sticky; top: 0; z-index: 50;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: var(--space-sm);
    background: var(--bone); color: var(--ink);
    padding: 0 var(--gutter);
    height: 72px;
    transition: height var(--dur-short) var(--ease-out);
  }
  .masthead[data-state="compact"] { height: 56px; box-shadow: 0 1px 0 var(--hairline); }
  .brand { justify-self: center; }
  .right { justify-self: end; display: flex; align-items: center; gap: var(--space-lg); }

  .menu-btn {
    justify-self: start; display: inline-flex; align-items: center; gap: var(--space-xs);
    background: none; border: 0; padding: var(--space-2xs) 0; cursor: pointer; color: inherit;
    font: 600 var(--text-xs) / 1 var(--font-body); letter-spacing: 0.16em; text-transform: uppercase;
    min-height: 44px;
  }
  .bars { display: grid; gap: 5px; }
  .bars span { display: block; width: 22px; height: 2px; background: currentColor; transition: transform var(--dur-short) var(--ease-out); }
  .menu-btn[aria-expanded="true"] .bars span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .bars span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .menu-btn:focus-visible, .bag:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }

  .bag {
    color: inherit; text-decoration: none; white-space: nowrap;
    font: 600 var(--text-xs) / 1 var(--font-body); letter-spacing: 0.16em; text-transform: uppercase;
    display: inline-flex; align-items: center; gap: var(--space-2xs); min-height: 44px;
  }
  .bag-badge {
    background: var(--ink); color: var(--bone); border-radius: 999px;
    font-size: 11px; padding: 2px 7px; min-width: 20px; text-align: center; letter-spacing: 0;
  }

  .menu {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 49;
    background: var(--bone); color: var(--ink);
    border-top: 1px solid var(--hairline);
    padding: var(--space-xl) var(--gutter) var(--space-lg) calc(var(--gutter) + var(--space-sm));
    overflow-y: auto;
    display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-xl);
  }
  .menu[hidden] { display: none; }
  .menu-links { list-style: none; margin: 0; padding: 0; }
  .menu-links a {
    display: flex; align-items: baseline; gap: var(--space-sm);
    color: inherit; text-decoration: none; padding: var(--space-2xs) 0;
    font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
    font-weight: 800; text-transform: uppercase; line-height: 0.95;
    font-size: clamp(44px, 9vw, 96px);
  }
  .menu-links a:hover span:first-child, .menu-links a.active span:first-child {
    text-decoration: underline; text-decoration-color: var(--wire); text-decoration-thickness: 6px; text-underline-offset: 8px;
  }
  .menu-links .n { font: 600 var(--text-sm) / 1 var(--font-body); color: var(--muted); }
  .menu-foot { display: grid; gap: var(--space-md); }
  .menu-label { margin: 0; font-size: var(--text-sm); color: var(--muted); }
  .menu-label span { color: var(--ink); font-weight: 600; }
  .menu-socials { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-lg); }
  .menu-socials a { color: inherit; font-size: var(--text-sm); font-weight: 600; white-space: nowrap; }

  @media (max-width: 760px) {
    .wires-desktop, .menu-word { display: none; }
    .masthead { height: 60px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead, .bars span { transition: none; }
  }
</style>
