---
// Pick your wire: recolours the whole site and remembers the choice.
// `compact` = the swatch row in the nav. `full` = the homepage section.
import wires from '../data/wires.json';
import season from '../data/season.json';
interface Props { variant?: 'compact' | 'full' }
const { variant = 'compact' } = Astro.props;
---
<div class:list={['wire-picker', variant]} role="group" aria-label="Pick your wire colour">
  {wires.map((w) => (
    <button type="button" class="wire-btn" data-wire={w.hex} data-wire-name={w.name}
      aria-pressed={w.hex === season.wire ? 'true' : 'false'} aria-label={`${w.name} wire`}>
      <span class="dot" style={`--dot:${w.hex}`}></span>
      {variant === 'full' && <span class="label">{w.name}</span>}
    </button>
  ))}
</div>

<script>
  const KEY = 'ow-wire';
  function apply(hex: string, name: string, save: boolean) {
    document.documentElement.style.setProperty('--wire', hex);
    document.querySelectorAll<HTMLButtonElement>('.wire-btn').forEach((b) => {
      b.setAttribute('aria-pressed', b.dataset.wire === hex ? 'true' : 'false');
    });
    document.querySelectorAll('[data-current-wire]').forEach((el) => { el.textContent = name; });
    if (save) { try { localStorage.setItem(KEY, hex); } catch {} }
  }
  // Sync buttons with whatever wire the page loaded with (season default or saved choice).
  const current = getComputedStyle(document.documentElement).getPropertyValue('--wire').trim().toUpperCase();
  const match = document.querySelector<HTMLButtonElement>(`.wire-btn[data-wire="${current}"]`);
  if (match) apply(match.dataset.wire!, match.dataset.wireName!, false);
  document.querySelectorAll<HTMLButtonElement>('.wire-btn').forEach((b) => {
    b.addEventListener('click', () => apply(b.dataset.wire!, b.dataset.wireName!, true));
  });
</script>

<style>
  .wire-picker { display: flex; align-items: center; }
  .wire-btn {
    background: none; border: 0; padding: 0; cursor: pointer; color: inherit;
    display: inline-flex; align-items: center; gap: var(--space-xs);
    font: inherit;
  }
  .dot {
    display: block; border-radius: 50%; background: var(--dot);
    box-shadow: inset 0 0 0 1px rgba(21, 21, 21, 0.18);
    transition: transform var(--dur-short) var(--ease-out);
  }
  .wire-btn[aria-pressed="true"] .dot { outline: 2px solid currentColor; outline-offset: 2px; }
  .wire-btn:hover .dot { transform: translateY(-2px); }
  .wire-btn:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 4px; }

  .compact { gap: 6px; }
  .compact .dot { width: 12px; height: 12px; }
  .compact .wire-btn { min-width: 24px; min-height: 24px; justify-content: center; }

  .full { flex-wrap: wrap; gap: var(--space-md) var(--space-lg); }
  .full .dot { width: 44px; height: 44px; }
  .full .label { font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.04em; white-space: nowrap; }
  .full .wire-btn[aria-pressed="true"] .label { text-decoration: underline; text-decoration-color: var(--wire); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  @media (prefers-reduced-motion: reduce) { .dot { transition: none; } }
</style>
