---
// The swappable seasonal opener. All copy + the season's wire come from
// src/data/season.json. The last headline line is underlined with the wire.
import season from '../data/season.json';
const lines = season.headline;
const last = lines.length - 1;
---
<section class="season">
  <h1 class="headline">
    {lines.map((l, i) => <span class:list={['l', { wired: i === last }]}>{l}</span>)}
  </h1>
  <div class="aside">
    <p class="sub">{season.sub}</p>
    <div class="actions">
      <a href={season.ctaHref} class="button">{season.ctaLabel}</a>
      <a href="#lines" class="quiet">Shop what’s here</a>
    </div>
  </div>
</section>

<style>
  .season {
    background: var(--washed-black); color: var(--bone);
    padding: var(--space-2xl) var(--gutter) var(--space-xl) calc(var(--gutter) + var(--space-md));
    display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-xl); align-items: end;
  }
  .headline {
    margin: 0; min-width: 0; overflow-wrap: anywhere;
    font-family: var(--font-display); font-stretch: 62%; font-variation-settings: 'wdth' 62;
    font-weight: 800; text-transform: uppercase; line-height: 0.88;
    font-size: clamp(64px, 11vw, 176px);
  }
  .l { display: block; }
  .wired {
    text-decoration: underline; text-decoration-color: var(--wire);
    text-decoration-thickness: 0.08em; text-underline-offset: 0.1em;
    transition: text-decoration-color var(--dur-short) var(--ease-out);
  }
  .aside { padding-bottom: var(--space-sm); }
  .sub { margin: 0 0 var(--space-lg); color: var(--linen); font-size: var(--text-lg); line-height: 1.45; max-width: 30ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-lg); }
  .season .button { background: var(--bone); color: var(--ink); white-space: nowrap; }
  .season .button:focus-visible { outline-color: var(--bone); }
  .quiet { color: var(--bone); font-size: var(--text-sm); font-weight: 600; white-space: nowrap; text-underline-offset: 5px; }
  .quiet:hover { text-decoration-color: var(--wire); text-decoration-thickness: 2px; }
  @media (max-width: 860px) {
    .season { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); padding-top: var(--space-xl); }
  }
</style>
